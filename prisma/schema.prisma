generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"  // This will be overridden by prisma.config.ts
  url      = env("DATABASE_URL")
}

// Your models...
model User {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  email            String    @unique
  password         String
  joinDate         DateTime  @default(now())
  updatedDate      DateTime  @updatedAt
  active           Boolean   @default(true)
  banned           Boolean   @default(false)
  isStaff          Boolean   @default(false)
  isSuperuser      Boolean   @default(false)
  staffTeamId      Int?
  
  staffTeam        StaffTeam?            @relation(fields: [staffTeamId], references: [id])
  profile          UserProfile?
  devices          Device[]
  ips              IP[]
  bans             Ban[]
  subscriptions    ActiveSubscription[]
  operators        Operator[]
  vehicleChanges   VehicleChange[]       @relation("ChangedBy")
  vehicleApprovals VehicleChange[]       @relation("ApprovedBy")
  liveries         Livery[]              @relation("AddedBy")
  liveriesUpdated  Livery[]              @relation("UpdatedBy")
  types            Type[]                @relation("TypeAddedBy")
  typesUpdated     Type[]                @relation("TypeUpdatedBy")
  routeTypes       RouteType[]           @relation("RouteTypeAddedBy")
  routeTypesUpdated RouteType[]          @relation("RouteTypeUpdatedBy")
  helpers          Helper[]
  lastEditedVehicles Vehicle[]
}

model StaffTeam {
  id       Int           @id @default(autoincrement())
  name     String
  perms    StaffPerm[]
  users    User[]
}

model StaffPerm {
  id       Int          @id @default(autoincrement())
  name     String
  slug     String       @unique
  teams    StaffTeam[]
}

model UserProfile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  pfp          String?
  banner       String?
  themeId      Int?
  darkMode     Boolean  @default(false)
  otherDetails String?  // JSON stored as string for SQLite compatibility
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme        Theme?   @relation(fields: [themeId], references: [id])
  badges       Badge[]
}

model Theme {
  id        Int            @id @default(autoincrement())
  name      String
  public    Boolean        @default(false)
  darkCSS   String
  lightCSS  String
  weight    Int            @default(0)
  profiles  UserProfile[]
}

model Badge {
  id            Int            @id @default(autoincrement())
  name          String
  foreground    String
  background    String
  additionalCSS String?
  selfAssign    Boolean        @default(false)
  profiles      UserProfile[]
}

model Device {
  id          Int      @id @default(autoincrement())
  fingerprint String
  details     String
  userId      Int
  ip          String
  timesUsed   Int      @default(0)
  lastUsed    DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bans        Ban[]
}

model IP {
  id         Int      @id @default(autoincrement())
  ip         String
  userId     Int
  timesUsed  Int      @default(0)
  lastUsed   DateTime @updatedAt
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bans       Ban[]
}

model Ban {
  id       Int      @id @default(autoincrement())
  userId   Int
  reason   String
  
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ips      IP[]
  devices  Device[]
}

model ActiveSubscription {
  id         Int      @id @default(autoincrement())
  userId     Int
  subId      String
  customerId String
  invoiceIds String   // JSON stored as string
  startDate  DateTime
  endDate    DateTime
  updatedAt  DateTime @updatedAt
  plan       String
  isTrial    Boolean  @default(false)
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Operator {
  id             Int       @id @default(autoincrement())
  name           String
  code           String    @unique
  slug           String    @unique
  details        String?   // JSON stored as string
  ownerId        Int
  groupId        Int?
  organisationId Int?
  verified       Boolean   @default(false)
  publicNotes    String?
  
  owner          User      @relation(fields: [ownerId], references: [id])
  group          Group?    @relation("OperatorGroup", fields: [groupId], references: [id])
  organisation   Group?    @relation("OperatorOrganisation", fields: [organisationId], references: [id])
  regions        Region[]
  vehicles       Vehicle[]
  updates        Update[]
  routes         Route[]
  boards         Board[]
}

model Region {
  id        Int        @id @default(autoincrement())
  name      String
  code      String     @unique
  parentId  Int?
  
  parent    Region?    @relation("RegionHierarchy", fields: [parentId], references: [id])
  children  Region[]   @relation("RegionHierarchy")
  operators Operator[]
}

model OperatorType {
  id        Int      @id @default(autoincrement())
  name      String
  published Boolean  @default(false)
}

model Group {
  id                  Int        @id @default(autoincrement())
  name                String
  parentId            Int?
  public              Boolean    @default(true)
  type                String     // "Group" or "Organisation"
  
  parent              Group?     @relation("GroupHierarchy", fields: [parentId], references: [id])
  children            Group[]    @relation("GroupHierarchy")
  operatorsAsGroup    Operator[] @relation("OperatorGroup")
  operatorsAsOrg      Operator[] @relation("OperatorOrganisation")
}

model Update {
  id         Int      @id @default(autoincrement())
  name       String
  details    String
  operatorId Int
  
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
}

model Helper {
  id     Int          @id @default(autoincrement())
  userId Int
  
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  perms  HelperPerm[]
}

model HelperPerm {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  permLevel Int
  helpers   Helper[]
}

model Vehicle {
  id                  Int            @id @default(autoincrement())
  operatorId          Int
  fleetNumber         String
  fleetNumberSorting  String
  reg                 String?
  prevReg             String?
  liveryId            Int?
  details             String?        // JSON stored as string
  features            String?        // JSON stored as string
  notes               String?
  typeId              Int?
  isInService         Boolean        @default(true)
  isForSale           Boolean        @default(false)
  vehicleCategoryId   Int?
  lastEditedById      Int?
  
  operator            Operator       @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  livery              Livery?        @relation(fields: [liveryId], references: [id])
  type                Type?          @relation(fields: [typeId], references: [id])
  lastEditedBy        User?          @relation(fields: [lastEditedById], references: [id])
  changes             VehicleChange[]
}

model VehicleChange {
  id           Int       @id @default(autoincrement())
  vehicleId    Int
  changes      String    // JSON stored as string
  changedAt    DateTime  @default(now())
  approvedAt   DateTime?
  changedById  Int
  approvedById Int?
  
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  changedBy    User      @relation("ChangedBy", fields: [changedById], references: [id])
  approvedBy   User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
}

model Livery {
  id           Int      @id @default(autoincrement())
  name         String
  blob         String
  textColour   String
  strokeColour String
  leftCSS      String
  rightCSS     String
  status       String   @default("Pending")
  addedById    Int
  updatedById  Int?
  updatedAt    DateTime @updatedAt
  
  addedBy      User     @relation("AddedBy", fields: [addedById], references: [id])
  updatedBy    User?    @relation("UpdatedBy", fields: [updatedById], references: [id])
  vehicles     Vehicle[]
}

model Type {
  id           Int      @id @default(autoincrement())
  name         String
  fuelType     String
  doubleDecker Boolean  @default(false)
  status       String   @default("Pending")
  addedById    Int
  updatedById  Int?
  updatedAt    DateTime @updatedAt
  
  addedBy      User     @relation("TypeAddedBy", fields: [addedById], references: [id])
  updatedBy    User?    @relation("TypeUpdatedBy", fields: [updatedById], references: [id])
  vehicles     Vehicle[]
}

model Route {
  id             Int        @id @default(autoincrement())
  routeNumber    String
  routeName      String
  destinations   String     // JSON stored as string
  details        String?    // JSON stored as string
  hidden         Boolean    @default(false)
  linkedRouteId  Int?
  relatedRouteId Int?
  routeTypeId    Int?
  
  linkedRoute    Route?     @relation("LinkedRoutes", fields: [linkedRouteId], references: [id])
  linkedBy       Route[]    @relation("LinkedRoutes")
  relatedRoute   Route?     @relation("RelatedRoutes", fields: [relatedRouteId], references: [id])
  relatedBy      Route[]    @relation("RelatedRoutes")
  routeType      RouteType? @relation(fields: [routeTypeId], references: [id])
  operators      Operator[]
  boardTrips     BoardTrip[]
}

model RouteType {
  id          Int      @id @default(autoincrement())
  name        String
  status      String   @default("Pending")
  addedById   Int
  updatedById Int?
  updatedAt   DateTime @updatedAt
  
  addedBy     User     @relation("RouteTypeAddedBy", fields: [addedById], references: [id])
  updatedBy   User?    @relation("RouteTypeUpdatedBy", fields: [updatedById], references: [id])
  routes      Route[]
}

model Board {
  id         Int       @id @default(autoincrement())
  name       String
  operatorId Int
  type       String    // "RunningBoard" or "Duty"
  
  operator   Operator  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  trips      BoardTrip[]
}

model BoardTrip {
  id          Int    @id @default(autoincrement())
  boardId     Int
  routeNumber String
  routeLinkId Int?
  time        String // Stored as string (HH:MM:SS)
  direction   String // "inbound" or "outbound"
  startAtStop String
  endAtStop   String
  startAtDest String
  endAtDest   String
  
  board       Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  routeLink   Route? @relation(fields: [routeLinkId], references: [id])
}